# ============================================
# CONFIGURAÇÃO DE CREDENCIAIS E SERVIÇOS
# ============================================

# 1. API DE VOOS (Google Flights via SerpApi)
# Obtenha sua chave gratuita em 1 clique em: https://serpapi.com/
# Se deixar em branco, o sistema entra em Modo Simulação (Mock) com dados realistas
SERPAPI_KEY=

# 2. CONFIGURAÇÃO DE EMAIL (SMTP)
# Exemplo para Gmail (requer Senha de App em https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-16-digitos
SMTP_FROM_NAME=Passagens Baratas ✈️
SMTP_USE_TLS=true

# 3. AGENDAMENTO E BANCO DE DADOS
CHECK_INTERVAL_MINUTES=60
DATABASE_URL=sqlite:///./flight_alerts.db
